{
    "name": "bitgen/sdk",
    "description": "Official PHP SDK for the BITGEN API v4",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "bitgen",
        "crypto",
        "sdk"
    ],
    "homepage": "https://github.com/bitgenplatform/sdk-php",
    "authors": [
        {
            "name": "BITGEN",
            "homepage": "https://bitgen.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Bitgen\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bitgen\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
